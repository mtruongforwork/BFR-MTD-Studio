<Project>
  <!-- Phiên bản của mọi assembly (FileVersion/ProductVersion của exe). Giữ khớp với BFR.Core.AppVersion.Current;
       test VersionConsistencyTests sẽ báo lỗi nếu lệch. -->
  <PropertyGroup>
    <Version>3.1.0</Version>
  </PropertyGroup>

  <!-- Chỉ cho project trong tests/: chạy được trên runtime .NET mới hơn (máy dev chỉ cài .NET 10 vẫn `dotnet test` được).
       Ứng dụng phát hành (src/) KHÔNG bị ảnh hưởng: vẫn khoá vào runtime .NET 8 như cũ. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('/', '\').Contains('\tests\'))">
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
