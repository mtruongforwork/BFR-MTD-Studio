<Window x:Class="BFR.App.RegexTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:BFR.App.Infrastructure"
        xmlns:mac="clr-namespace:BFR.App.Controls.Mac"
        Title="Regex tester"
        Width="780" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource Mac.Font}"
        FontSize="13"
        UseLayoutRounding="True"
        AutomationProperties.Name="Regex tester dialog">

    <Border Background="{DynamicResource Mac.SheetBg}"
            BorderBrush="{DynamicResource Mac.Separator}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="0,12,0,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Mac.FontSemi}" Foreground="{DynamicResource Mac.Label}" />
                <Button Style="{DynamicResource Mac.TrafficDot}" Background="#FF5F57" Tag="×" Margin="14,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="Close_Click"
                        AutomationProperties.Name="Close regex tester" />
            </Grid>

            <!-- ===== Ô nhập ===== -->
            <Grid Grid.Row="1" Margin="22,16,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PatternLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Mac.Label2}" Margin="0,0,10,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource Mac.TextBox}" AutomationProperties.Name="Regex pattern"
                         m:Motion.HasError="{Binding HasError}" />
                <CheckBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Center"
                          Content="{Binding IgnoreCaseLabel}" IsChecked="{Binding IgnoreCase}"
                          Style="{DynamicResource Mac.CheckBox}" AutomationProperties.Name="Ignore case" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ReplacementLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Mac.Label2}" Margin="0,0,10,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource Mac.TextBox}" AutomationProperties.Name="Regex replacement" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding InputLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Mac.Label2}" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource Mac.TextBox}" AutomationProperties.Name="Regex test string" />
                <Button Grid.Row="2" Grid.Column="2" Content="{Binding UseSelectedLabel}"
                        Style="{DynamicResource Mac.Button}" Click="UseSelected_Click"
                        AutomationProperties.Name="Use selected name" />
            </Grid>

            <!-- ===== Kết quả ===== -->
            <Border Grid.Row="2" Margin="22,14,22,0" CornerRadius="8" Padding="12,10"
                    Background="{DynamicResource Mac.GroupBg}"
                    BorderBrush="{DynamicResource Mac.GroupBorder}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <mac:MacIcon Data="{DynamicResource Icon.Info}" Size="15" Margin="0,0,8,0"
                                     Foreground="{DynamicResource Mac.Accent}" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Mac.Label}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Mac.Bad}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding ResultLabel}" Margin="0,10,0,0"
                               Foreground="{DynamicResource Mac.Label2}" />
                    <TextBox Text="{Binding Output, Mode=OneWay}" Margin="0,4,0,0" MinHeight="34"
                             IsReadOnly="True" Style="{DynamicResource Mac.TextBox}"
                             FontFamily="{StaticResource AppFontMono}" />

                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Matches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Mac.Label}"
                                                   FontFamily="{StaticResource AppFontMono}" Margin="0,0,12,0" />
                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{DynamicResource Mac.Label2}" Margin="0,0,8,0">
                                                        <Run Text="[" />
                                                        <Run Text="{Binding Index, Mode=OneWay}" />
                                                        <Run Text="]: " />
                                                        <Run Text="{Binding Value, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== Chân dialog ===== -->
            <Grid Grid.Row="3" Margin="22,16,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding ApplyAllLabel}" Style="{DynamicResource Mac.Button.Primary}"
                        Click="ApplyAll_Click" AutomationProperties.Name="Apply regex to all files" />

                <ComboBox Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" Width="240"
                          ItemsSource="{Binding Samples}"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedSampleName, Mode=TwoWay}"
                          Style="{DynamicResource Mac.ComboBox}"
                          AutomationProperties.Name="Regex sample library">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="{Binding HintText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Mac.Label3}" />
            </Grid>
        </Grid>
    </Border>
</Window>
