<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:BFR.App.Controls.Mac"
                    xmlns:m="clr-namespace:BFR.App.Infrastructure">
    <!-- ===== 9. Menu ngữ cảnh / pull-down: đánh dấu chọn, menu con, vạch ngăn ===== -->
    <Style x:Key="Mac.MenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,4" Background="{DynamicResource Mac.Separator}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mac.MenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Height="24" MinWidth="200" CornerRadius="5" Background="Transparent" Padding="4,0,10,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="18">
                                    <ctl:MacIcon x:Name="Check" Data="{DynamicResource Icon.Check}" Size="12" StrokeThickness="2.5"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Hidden" />
                                </Grid>
                                <ctl:MacIcon x:Name="Arrow" DockPanel.Dock="Right" Data="{DynamicResource Icon.ChevronRight}" Size="11" StrokeThickness="2.5"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" Margin="12,0,0,0" />
                                <TextBlock x:Name="Gesture" DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Mac.Label3}" VerticalAlignment="Center" Margin="24,0,0,0" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-12" VerticalOffset="-9" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <Border Margin="12,4,12,16" Padding="5" CornerRadius="8" Background="{DynamicResource Mac.MenuBg}" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3" /></Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mac.AccentFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource Mac.OnAccent}" />
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource Mac.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mac.ContextMenu" TargetType="ContextMenu">
        <Style.Resources>
            <!-- Style ngầm thay cho ItemContainerStyle: ItemContainerStyle bị áp cả lên Separator và làm văng lỗi. -->
            <Style TargetType="MenuItem" BasedOn="{StaticResource Mac.MenuItem}" />
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Mac.MenuSeparator}" />
        </Style.Resources>
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border m:Motion.PopIn="True" Margin="12,4,12,16" Padding="5" CornerRadius="8" Background="{DynamicResource Mac.MenuBg}" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3" /></Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 10. Tiến trình: thanh xác định và không xác định ===== -->
    <Style x:Key="Mac.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Mac.Track}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Mac.Accent}" HorizontalAlignment="Left" />
                        <!-- Chế độ không xác định: một đoạn sáng chạy qua, độc lập với độ rộng thanh. -->
                        <Border x:Name="Sweep" CornerRadius="3" Background="{DynamicResource Mac.Accent}" Visibility="Collapsed">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00000000" Offset="0.25" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#00000000" Offset="0.75" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True" />
                                <Condition Property="IsVisible" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SweepLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.75" To="0.75" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepLoop" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tooltip: mờ dần 120 ms. Độ trễ 600 ms đặt trong style của nút. ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="Bd" Padding="8,4" MaxWidth="320" CornerRadius="5" Background="{DynamicResource Mac.MenuBg}" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thanh cuộn overlay 7 px: hiện khi cuộn hoặc rê chuột, tự ẩn sau 1 giây (MacScroll) ===== -->
    <Style x:Key="Mac.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="1.5" CornerRadius="3.5" Background="{DynamicResource Mac.ScrollThumb}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mac.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="m:MacScroll.AutoHide" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Mac.ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource Mac.ScrollThumbStyle}" MinHeight="28" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Mac.ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Mac.ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource Mac.ScrollThumbStyle}" MinWidth="28" /></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Mac.ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
