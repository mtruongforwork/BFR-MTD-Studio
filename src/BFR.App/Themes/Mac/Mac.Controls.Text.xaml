<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:BFR.App.Controls.Mac"
                    xmlns:m="clr-namespace:BFR.App.Infrastructure">
    <!-- ===== Chữ ===== -->
    <Style x:Key="Mac.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Mac.LargeTitle" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
        <Setter Property="FontSize" Value="26" />
    </Style>
    <Style x:Key="Mac.Title2" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Mac.Headline" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
    </Style>
    <Style x:Key="Mac.Callout" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label2}" />
    </Style>
    <Style x:Key="Mac.Section" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label3}" />
    </Style>

    <!-- ===== Nhóm form inset grouped ===== -->
    <Style x:Key="Mac.Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mac.GroupBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mac.GroupBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="Mac.RowLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Mac.Separator}" />
    </Style>
</ResourceDictionary>
