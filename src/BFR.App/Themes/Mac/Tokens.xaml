<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Token kiểu macOS (plan v3.2, mục 4). Màu nằm ở Palette.*.xaml; mọi khoá bắt đầu bằng "Mac.". -->
    <FontFamily x:Key="Mac.Font">pack://application:,,,/Resources/Fonts/#Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Mac.FontMedium">pack://application:,,,/Resources/Fonts/#Inter Medium, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Mac.FontSemi">pack://application:,,,/Resources/Fonts/#Inter SemiBold, Segoe UI Semibold, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="Mac.SizeLargeTitle">26</sys:Double>
    <sys:Double x:Key="Mac.SizeTitle2">17</sys:Double>
    <sys:Double x:Key="Mac.SizeBody">13</sys:Double>
    <sys:Double x:Key="Mac.SizeCallout">12</sys:Double>
    <sys:Double x:Key="Mac.SizeFootnote">11</sys:Double>

    <CornerRadius x:Key="Mac.RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="Mac.RadiusGroup">10</CornerRadius>
    <CornerRadius x:Key="Mac.RadiusSheet">12</CornerRadius>
</ResourceDictionary>
