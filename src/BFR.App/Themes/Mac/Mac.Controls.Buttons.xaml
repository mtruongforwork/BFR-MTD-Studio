<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:BFR.App.Controls.Mac"
                    xmlns:m="clr-namespace:BFR.App.Infrastructure">
    <!-- ===== 1. Push button ===== -->
    <Style x:Key="Mac.Button" TargetType="Button">
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="Background" Value="{DynamicResource Mac.ControlBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mac.ControlBorder}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="m:Motion.PressScale" Value="0.97" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="3" BorderBrush="{DynamicResource Mac.FocusRing}" Visibility="Collapsed" />
                        <!-- Mép dưới đậm hơn thay cho bóng đổ (không dùng Effect trên vùng cuộn). -->
                        <Border CornerRadius="6" Background="{DynamicResource Mac.ControlEdge}" Margin="0,1,0,-1" Opacity="0.55" />
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Wash" CornerRadius="6" Background="{DynamicResource Mac.Hover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Background" Value="{DynamicResource Mac.Track}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mac.Button.Primary" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
        <Setter Property="Background" Value="{DynamicResource Mac.AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.OnAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ===== 2. Toolbar button ===== -->
    <Style x:Key="Mac.ToolbarButton" TargetType="Button">
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label2}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="m:Motion.PressScale" Value="0.94" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Wash" CornerRadius="6" Background="{DynamicResource Mac.Hover}" Opacity="0" />
                        <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Mac.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Traffic light: ký hiệu chỉ hiện khi rê chuột vào cụm ba nút (Tag của cha đặt bằng DataTrigger). -->
    <Style x:Key="Mac.TrafficDot" TargetType="Button">
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="0.5" />
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontSize="10" FontWeight="Bold" Foreground="#99000000"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Mac.TrackOff}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Biến thể: nhỏ, nguy hiểm, liên kết ===== -->
    <Style x:Key="Mac.Button.Small" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style x:Key="Mac.Button.Destructive" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Mac.Bad}" />
    </Style>
    <Style x:Key="Mac.Button.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.AccentText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" Padding="2,0">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mac.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút mở rộng (disclosure): chevron xoay 90 độ ===== -->
    <Style x:Key="Mac.Disclosure" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ctl:MacIcon x:Name="Chevron" Data="{DynamicResource Icon.ChevronRight}" Size="12" StrokeThickness="2.5" Foreground="{DynamicResource Mac.Label2}" Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mac.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="m:Motion.Angle" Value="90" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== M5: tiêu đề nhóm thu gọn được trong sidebar ===== -->
    <Style x:Key="Mac.SidebarSection" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource Mac.FontSemi}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label3}" />
        <Setter Property="Margin" Value="12,12,12,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Padding="4,0">
                        <DockPanel>
                            <ctl:MacIcon x:Name="Chevron" DockPanel.Dock="Right" Data="{DynamicResource Icon.ChevronRight}" Size="11" StrokeThickness="2.5" Foreground="{DynamicResource Mac.Label3}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mac.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="m:Motion.Angle" Value="90" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút kiểu mục thanh bên (nhóm yêu thích) ===== -->
    <Style x:Key="Mac.SidebarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Wash" CornerRadius="6" Background="{DynamicResource Mac.Hover}" Opacity="0" />
                        <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Mac.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="8,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô mở tìm lệnh trên toolbar ===== -->
    <Style x:Key="Mac.SearchTrigger" TargetType="Button">
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="14" Background="{DynamicResource Mac.Track}" />
                        <Border x:Name="Wash" CornerRadius="14" Background="{DynamicResource Mac.Hover}" Opacity="0" />
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Mac.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="10,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
