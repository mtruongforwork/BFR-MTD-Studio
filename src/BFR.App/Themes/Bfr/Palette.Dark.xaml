<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu tối. Màu (Color) tách khỏi cọ (Brush) để test tương phản đọc được trực tiếp giá trị màu. -->

    <Color x:Key="BfrBgBaseColor">#FF1E1E1E</Color>
    <Color x:Key="BfrSurface1Color">#FF242424</Color>
    <Color x:Key="BfrSurface2Color">#FF2A2A2A</Color>
    <Color x:Key="BfrSidebarFillColor">#B8262626</Color>
    <Color x:Key="BfrInspectorFillColor">#FF252525</Color>
    <Color x:Key="BfrGlassColor">#0FFFFFFF</Color>
    <Color x:Key="BfrLineColor">#14FFFFFF</Color>
    <Color x:Key="BfrFgColor">#FFF2F2F7</Color>
    <Color x:Key="BfrFg2Color">#FFA3A6B5</Color>
    <Color x:Key="BfrFg3Color">#FF8A8EA0</Color>
    <Color x:Key="BfrOkColor">#FF4EEAA5</Color>
    <Color x:Key="BfrWarnColor">#FFFFB74D</Color>
    <Color x:Key="BfrBadColor">#FFFF6B6B</Color>
    <Color x:Key="BfrOkSoftColor">#1F4EEAA5</Color>
    <Color x:Key="BfrWarnSoftColor">#24FFB74D</Color>
    <Color x:Key="BfrBadSoftColor">#24FF6B6B</Color>
    <Color x:Key="BfrShadowColor">#FF000000</Color>
    <Color x:Key="BfrOnAccentColor">#FFFFFFFF</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrShadowOpacity">0.38</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrGlowOpacity">0.22</sys:Double>

    <Color x:Key="BfrGlassFillColor">#0BFFFFFF</Color>
    <Color x:Key="BfrGlassFillStrongColor">#E6262626</Color>
    <Color x:Key="BfrGlassHoverFillColor">#14FFFFFF</Color>
    <Color x:Key="BfrGlassSheenColor">#0FFFFFFF</Color>
    <Color x:Key="BfrGlassRimTopColor">#12FFFFFF</Color>
    <Color x:Key="BfrGlassRimBottomColor">#12FFFFFF</Color>
    <Color x:Key="BfrHoverRimColor">#24FFFFFF</Color>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrBlobOpacity">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrBackdropTintOpacity">1.0</sys:Double>
    <SolidColorBrush x:Key="BfrBgBase" Color="{DynamicResource BfrBgBaseColor}" />
    <SolidColorBrush x:Key="BfrSurface1" Color="{DynamicResource BfrSurface1Color}" />
    <SolidColorBrush x:Key="BfrSurface2" Color="{DynamicResource BfrSurface2Color}" />
    <SolidColorBrush x:Key="BfrGlass" Color="{DynamicResource BfrGlassColor}" />
    <SolidColorBrush x:Key="BfrLine" Color="{DynamicResource BfrLineColor}" />
    <SolidColorBrush x:Key="BfrFg" Color="{DynamicResource BfrFgColor}" />
    <SolidColorBrush x:Key="BfrFg2" Color="{DynamicResource BfrFg2Color}" />
    <SolidColorBrush x:Key="BfrFg3" Color="{DynamicResource BfrFg3Color}" />
    <SolidColorBrush x:Key="BfrOk" Color="{DynamicResource BfrOkColor}" />
    <SolidColorBrush x:Key="BfrWarn" Color="{DynamicResource BfrWarnColor}" />
    <SolidColorBrush x:Key="BfrBad" Color="{DynamicResource BfrBadColor}" />
    <SolidColorBrush x:Key="BfrOkSoft" Color="{DynamicResource BfrOkSoftColor}" />
    <SolidColorBrush x:Key="BfrWarnSoft" Color="{DynamicResource BfrWarnSoftColor}" />
    <SolidColorBrush x:Key="BfrBadSoft" Color="{DynamicResource BfrBadSoftColor}" />
    <SolidColorBrush x:Key="BfrOnAccent" Color="{DynamicResource BfrOnAccentColor}" />

    <!-- Chữ nhấn (liên kết, focus ring) lấy từ bảng màu nhấn, biến thể dành cho nền tối. -->
    <SolidColorBrush x:Key="BfrAccFg" Color="{DynamicResource BfrAccFgDarkColor}" />

    <!-- Kính (glass) v2.1: nền trong mờ, lớp sáng phía trên, viền gradient 1 px. Dùng cho ô bento và thanh bên. -->
    <SolidColorBrush x:Key="BfrGlassFill" Color="{DynamicResource BfrGlassFillColor}" />
    <SolidColorBrush x:Key="BfrGlassFillStrong" Color="{DynamicResource BfrGlassFillStrongColor}" />
    <SolidColorBrush x:Key="BfrGlassHoverFill" Color="{DynamicResource BfrGlassHoverFillColor}" />
    <SolidColorBrush x:Key="BfrHoverRim" Color="{DynamicResource BfrHoverRimColor}" />
    <SolidColorBrush x:Key="BfrSidebarFill" Color="{DynamicResource BfrSidebarFillColor}" />
    <SolidColorBrush x:Key="BfrInspectorFill" Color="{DynamicResource BfrInspectorFillColor}" />
    <LinearGradientBrush x:Key="BfrGlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource BfrGlassSheenColor}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BfrGlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource BfrGlassRimTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource BfrGlassRimBottomColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
