<UserControl x:Class="BFR.App.Controls.TopNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Height="52"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="TopPillTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BfrFg2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="{DynamicResource BfrFontBodyMedium}" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfrSurface2}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfrLine}" />
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                                <Setter Property="FontFamily" Value="{DynamicResource BfrFontBodySemi}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BfrFg2}" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource BfrLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfrHoverRim}" />
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BfrGlassFillStrong}"
            BorderBrush="{DynamicResource BfrLine}"
            BorderThickness="0,0,0,1"
            Padding="16,0,150,0"
            MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bên trái: Logo + Tên + Pro/Free badge HOẶC nút < Trang chủ + Breadcrumb -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="BrandGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource BfrAccGradient}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8C5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource BfrOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource WindowTitle}" Margin="9,0,8,0" FontSize="13.5"
                               FontFamily="{DynamicResource BfrFontHeading}" Foreground="{DynamicResource BfrFg}"
                               VerticalAlignment="Center" />

                    <Button x:Name="TierBadge" Style="{StaticResource TopIconPillButton}" Padding="9,2" Height="22"
                            Click="TierBadge_Click" AutomationProperties.Name="License tier">
                        <TextBlock x:Name="TierBadgeText" Text="Free" FontSize="10.5" FontFamily="{DynamicResource BfrFontBodySemi}"
                                   Foreground="{DynamicResource BfrAccFg}" />
                    </Button>

                    <ui:Button x:Name="UpgradeButton" Appearance="Primary" Content="{DynamicResource Upgrade}"
                               Click="Upgrade_Click" Padding="9,2" Height="22" FontSize="11" Margin="6,0,0,0"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               AutomationProperties.Name="Upgrade to Pro" />
                </StackPanel>

                <StackPanel x:Name="BreadcrumbGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BackButton" Style="{StaticResource TopIconPillButton}" Padding="10,0" Height="28"
                            Click="Back_Click" AutomationProperties.Name="Back to home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="BackLabel" Text="{DynamicResource NavHome}" FontSize="12.5" FontFamily="{DynamicResource BfrFontBodyMedium}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="/" Foreground="{DynamicResource BfrFg3}" Margin="10,0" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock x:Name="ToolBreadcrumbText" Text="" Foreground="{DynamicResource BfrFg}"
                               FontFamily="{DynamicResource BfrFontHeading}" FontSize="13.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                </StackPanel>
            </StackPanel>

            <!-- Chính giữa: Segmented Pill Control 5 không gian -->
            <Border Grid.Column="1"
                    Background="#0DFFFFFF"
                    BorderBrush="{DynamicResource BfrLine}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="3"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabHome" Style="{StaticResource TopPillTabStyle}" GroupName="TopNav" Tag="Home"
                                 Content="{DynamicResource NavHome}" IsChecked="True" Checked="Tab_Checked"
                                 AutomationProperties.Name="Nav home" />
                    <RadioButton x:Name="TabTools" Style="{StaticResource TopPillTabStyle}" GroupName="TopNav" Tag="Tools"
                                 Content="{DynamicResource NavTools}" Checked="Tab_Checked"
                                 AutomationProperties.Name="Nav tools" />
                    <RadioButton x:Name="TabShelf" Style="{StaticResource TopPillTabStyle}" GroupName="TopNav" Tag="Shelf"
                                 Checked="Tab_Checked" AutomationProperties.Name="Nav shelf">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource NavShelf}" VerticalAlignment="Center" />
                            <Border x:Name="ShelfCountBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="999"
                                    Background="{DynamicResource BfrAccGradient}" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="ShelfCountText" Text="0" FontSize="10"
                                           FontFamily="{DynamicResource BfrFontBodySemi}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource BfrOnAccent}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabWatch" Style="{StaticResource TopPillTabStyle}" GroupName="TopNav" Tag="Watch"
                                 Content="{DynamicResource NavWatch}" Checked="Tab_Checked"
                                 AutomationProperties.Name="Nav watch folder" />
                    <RadioButton x:Name="TabHistory" Style="{StaticResource TopPillTabStyle}" GroupName="TopNav" Tag="History"
                                 Content="{DynamicResource NavHistory}" Checked="Tab_Checked"
                                 AutomationProperties.Name="Nav history" />
                </StackPanel>
            </Border>

            <!-- Bên phải: Spotlight Search pill (Ctrl+K) + Preset + Cài đặt -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SearchTrigger" Style="{StaticResource TopIconPillButton}" Padding="11,0" Margin="0,0,8,0"
                        Click="Search_Click" AutomationProperties.Name="Spotlight Search">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Ctrl+K" FontSize="11.5" FontFamily="{DynamicResource BfrFontMono}"
                                   Foreground="{DynamicResource BfrFg3}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="PresetsButton" Style="{StaticResource TopIconPillButton}" Width="30" Margin="0,0,6,0"
                        Click="Presets_Click" ToolTip="{DynamicResource NavPresets}" AutomationProperties.Name="Nav presets">
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                </Button>

                <Button x:Name="SettingsButton" Style="{StaticResource TopIconPillButton}" Width="30"
                        Click="Settings_Click" ToolTip="{DynamicResource NavSettings}" AutomationProperties.Name="Nav settings">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
