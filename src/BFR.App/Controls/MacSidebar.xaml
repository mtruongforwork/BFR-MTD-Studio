<UserControl x:Class="BFR.App.Controls.MacSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="TrafficDotStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" />
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontSize="8.5" FontWeight="Bold"
                                       Foreground="#CC000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-1,0,0" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacSidebarItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BfrFg2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource BfrFontBodyMedium}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                                <Setter Property="FontFamily" Value="{DynamicResource BfrFontBodySemi}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacFavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BfrFg2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource BfrFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BfrSidebarFill}"
            BorderBrush="{DynamicResource BfrLine}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <!-- Top 52px Window Chrome: Traffic Lights + Draggable Area -->
            <Border DockPanel.Dock="Top" Height="52" Background="Transparent"
                    MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="18,18,0,0">
                    <Button x:Name="CloseDot" Style="{StaticResource TrafficDotStyle}" Background="#FF5F56" Tag="×"
                            Click="Close_Click" AutomationProperties.Name="Close window" ToolTip="{DynamicResource TitleClose}" />
                    <Button x:Name="MinDot" Style="{StaticResource TrafficDotStyle}" Background="#FFBD2E" Tag="–"
                            Click="Minimize_Click" AutomationProperties.Name="Minimize window" ToolTip="{DynamicResource TitleMinimize}" />
                    <Button x:Name="ZoomDot" Style="{StaticResource TrafficDotStyle}" Background="#27C93F" Tag="+"
                            Click="Maximize_Click" AutomationProperties.Name="Zoom window" ToolTip="{DynamicResource TitleMaximize}" />
                </StackPanel>
            </Border>

            <!-- Bottom Pinned Footer: App Identity + Pro/Trial Badge + Settings (⌘,) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BfrLine}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="28" Height="28" Style="{StaticResource MacFavButtonStyle}"
                            Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            Click="Settings_Click" ToolTip="Cài đặt (⌘,)" AutomationProperties.Name="Nav settings">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13.5" />
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                                MouseLeftButtonUp="Tier_Click">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BfrAccGradient}"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8C5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource BfrOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource WindowTitle}" FontSize="12"
                                       FontFamily="{DynamicResource BfrFontBodySemi}" Foreground="{DynamicResource BfrFg}" />
                            <TextBlock x:Name="TierStatusText" Text="Free" FontSize="10.5"
                                       Foreground="{DynamicResource BfrFg3}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Scrollable Primary Nav + Favorites -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="Home"
                                 IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="Nav home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                       Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource NavHome}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTools" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="Tools"
                                 Checked="Nav_Checked" AutomationProperties.Name="Nav tools">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                       Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource NavTools}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavShelf" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="Shelf"
                                 Checked="Nav_Checked" AutomationProperties.Name="Nav shelf">
                        <DockPanel>
                            <Border x:Name="ShelfBadge" DockPanel.Dock="Right" Padding="6,1" CornerRadius="999"
                                    Background="#18FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="ShelfCountText" Text="0" FontSize="10.5"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BfrFg2}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                           Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource NavShelf}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWatch" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="Watch"
                                 Checked="Nav_Checked" AutomationProperties.Name="Nav watch folder">
                        <DockPanel>
                            <Ellipse x:Name="WatchActiveDot" DockPanel.Dock="Right" Width="7" Height="7"
                                     Fill="#34C759" VerticalAlignment="Center" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                           Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource NavWatch}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHistory" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="History"
                                 Checked="Nav_Checked" AutomationProperties.Name="Nav history">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                       Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource NavHistory}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPresets" Style="{StaticResource MacSidebarItemStyle}" GroupName="MacNav" Tag="Presets"
                                 Checked="Nav_Checked" AutomationProperties.Name="Nav presets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                       Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource NavPresets}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- YÊU THÍCH (synced with SettingsStore.FavoriteTools) -->
                    <StackPanel x:Name="FavoritesSection" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="FavoritesHeader" Text="YÊU THÍCH" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BfrFg3}" Margin="16,0,10,4" />
                        <StackPanel x:Name="FavoritesHost" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
