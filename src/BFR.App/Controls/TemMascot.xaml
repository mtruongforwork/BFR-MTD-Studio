<UserControl x:Class="BFR.App.Controls.TemMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="104" IsTabStop="False" Focusable="False" SnapsToDevicePixels="False">
    <!--
        Tem, linh vật của BFR: một chiếc thẻ nhãn có lỗ xỏ dây (đúng thứ app gắn lên tệp).
        Vẽ hoàn toàn bằng vector trong hệ toạ độ 100 x 104 nên co giãn theo Width/Height mà không vỡ nét.
        v3.2: đơn sắc theo màu nhấn macOS (viền và nét mặt Mac.Accent, thân nền đặc phủ Mac.AccentSoft). Biểu cảm đổi bằng State.
        Chuyển động (chớp mắt, nhấp nhô, thanh tiến trình, pháo giấy) do code-behind chạy và tắt khi giảm chuyển động.
    -->
    <UserControl.Resources>
        <Style x:Key="TemStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Mac.Accent}" />
            <Setter Property="StrokeThickness" Value="3.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="104" ClipToBounds="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="Wiggle" Angle="0" CenterX="50" CenterY="55" />
                    <TranslateTransform x:Name="Bob" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Dây xỏ -->
            <Path Data="M50,6 C43,6 38,11 38,17" Stroke="{DynamicResource Mac.Label3}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <!-- Thân thẻ: lớp nền đặc ở dưới để màu nhấn nhạt không bị nền phía sau xuyên qua -->
            <Path Fill="{DynamicResource Mac.SheetBg}" Data="M28,18 L72,18 A16,16 0 0 1 88,34 L88,72 A16,16 0 0 1 72,88 L28,88 A16,16 0 0 1 12,72 L12,34 A16,16 0 0 1 28,18 Z" />
            <Path Fill="{DynamicResource Mac.AccentSoft}" Stroke="{DynamicResource Mac.Accent}" StrokeThickness="3" StrokeLineJoin="Round"
                  Data="M28,18 L72,18 A16,16 0 0 1 88,34 L88,72 A16,16 0 0 1 72,88 L28,88 A16,16 0 0 1 12,72 L12,34 A16,16 0 0 1 28,18 Z" />
            <Ellipse Canvas.Left="44.5" Canvas.Top="21.5" Width="11" Height="11" Fill="{DynamicResource Mac.SheetBg}" Stroke="{DynamicResource Mac.Accent}" StrokeThickness="2.4" />

            <!-- Mắt mở (nghỉ, ái ngại): nhóm này chớp mắt -->
            <Canvas x:Name="EyesOpen">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="Blink" ScaleX="1" ScaleY="1" CenterX="50" CenterY="58" />
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="32.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{DynamicResource Mac.Accent}" />
                <Ellipse Canvas.Left="56.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{DynamicResource Mac.Accent}" />
            </Canvas>
            <!-- Mắt cong vui -->
            <Canvas x:Name="EyesHappy" Visibility="Collapsed">
                <Path Style="{StaticResource TemStroke}" StrokeThickness="3.4" Data="M31,59 Q38,50 45,59" />
                <Path Style="{StaticResource TemStroke}" StrokeThickness="3.4" Data="M55,59 Q62,50 69,59" />
            </Canvas>
            <!-- Mắt nhắm khi ngủ -->
            <Canvas x:Name="EyesSleep" Visibility="Collapsed">
                <Path Style="{StaticResource TemStroke}" Data="M31,60 Q38,66 45,60" />
                <Path Style="{StaticResource TemStroke}" Data="M55,60 Q62,66 69,60" />
            </Canvas>
            <!-- Mắt liếc sang phải khi đang làm -->
            <Canvas x:Name="EyesWork" Visibility="Collapsed">
                <Ellipse Canvas.Left="34.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{DynamicResource Mac.Accent}" />
                <Ellipse Canvas.Left="58.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{DynamicResource Mac.Accent}" />
            </Canvas>

            <!-- Lông mày xệ khi ái ngại -->
            <Path x:Name="Brows" Visibility="Collapsed" Style="{StaticResource TemStroke}" StrokeThickness="3" Data="M30,48 L42,44 M70,48 L58,44" />

            <!-- Miệng -->
            <Path x:Name="MouthSmile" Style="{StaticResource TemStroke}" Data="M43,71 Q50,78 57,71" />
            <Path x:Name="MouthBig" Visibility="Collapsed" Fill="{DynamicResource Mac.Accent}" Data="M40,70 Q50,81 60,70 Z" />
            <Path x:Name="MouthFrown" Visibility="Collapsed" Style="{StaticResource TemStroke}" Data="M41,75 Q50,68 59,75" />
            <Ellipse x:Name="MouthO" Visibility="Collapsed" Canvas.Left="46.6" Canvas.Top="70.4" Width="6.8" Height="5.2" Fill="{DynamicResource Mac.Accent}" />
            <Rectangle x:Name="MouthFlat" Visibility="Collapsed" Canvas.Left="43" Canvas.Top="71" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Mac.Accent}" />

            <!-- Giọt mồ hôi (ái ngại) -->
            <Path x:Name="Sweat" Visibility="Collapsed" Fill="{DynamicResource Mac.Accent}" Opacity="0.55" Data="M80,44 Q84,50 80,54 Q76,50 80,44 Z" />

            <!-- Chữ z khi ngủ -->
            <Canvas x:Name="Zzz" Visibility="Collapsed">
                <TextBlock Canvas.Left="74" Canvas.Top="14" Text="z" FontFamily="{DynamicResource Mac.FontSemi}" FontSize="13" Foreground="{DynamicResource Mac.Label2}" />
                <TextBlock Canvas.Left="85" Canvas.Top="3" Text="z" FontFamily="{DynamicResource Mac.FontSemi}" FontSize="10" Foreground="{DynamicResource Mac.Label2}" />
            </Canvas>

            <!-- Thanh tiến trình khi đang làm -->
            <Canvas x:Name="Progress" Visibility="Collapsed">
                <Rectangle Canvas.Left="22" Canvas.Top="94" Width="56" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Mac.Separator}" />
                <Rectangle x:Name="ProgressFill" Canvas.Left="22" Canvas.Top="94" Width="30" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Mac.Accent}" />
            </Canvas>

            <!-- Pháo giấy khi vui -->
            <Canvas x:Name="Confetti" Visibility="Collapsed">
                <Rectangle Canvas.Left="14" Canvas.Top="14" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Mac.Accent}"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="82" Canvas.Top="10" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Mac.Label3}"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="26" Canvas.Top="4" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Mac.Accent}"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="70" Canvas.Top="2" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Mac.Label3}"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
