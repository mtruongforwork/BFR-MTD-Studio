<ui:FluentWindow x:Class="BFR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BFR.App"
        xmlns:conv="clr-namespace:BFR.App.Converters"
        xmlns:ctl="clr-namespace:BFR.App.Controls"
        xmlns:mac="clr-namespace:BFR.App.Controls.Mac"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource WindowTitle}" Height="820" Width="1380"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Tabbed"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" PreviewDrop="Window_PreviewDrop" Drop="Window_Drop"
        AutomationProperties.Name="FileFlow Studio Main Window">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Giao diện kiểu macOS. Bảng màu được MacTheme.Apply thay theo sáng/tối, màu nhấn và tương phản cao. -->
                <ResourceDictionary Source="Themes/Mac/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Mac/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Mac/Icons.xaml" />
                <ResourceDictionary Source="Themes/Mac/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Menu ngữ cảnh cho từng dòng trong bảng xem trước (v1.0.2) -->
        <ContextMenu x:Key="RowContextMenu" Style="{StaticResource AppContextMenuStyle}">
            <MenuItem Header="{DynamicResource CtxOpenFile}" Click="ContextMenu_OpenFile_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource CtxOpenFolder}" Click="ContextMenu_OpenFolder_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource CtxCopyOldName}" Click="ContextMenu_CopyOldName_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource CtxCopyNewName}" Click="ContextMenu_CopyNewName_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource CtxManualRename}" InputGestureText="F2" Click="ContextMenu_ManualRename_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource CtxResetManualName}" Click="ContextMenu_ResetManualName_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource CtxToggleSelect}" Click="ContextMenu_ToggleSelect_Click" Style="{StaticResource AppMenuItemStyle}" />
            <MenuItem Header="{DynamicResource CtxRemoveFromList}" Click="ContextMenu_RemoveFromList_Click" Style="{StaticResource AppMenuItemStyle}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Error}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Thẻ quy tắc hiện đại phong cách PowerToys / WinUI 3 -->
        <DataTemplate x:Key="RuleCardTemplate">
            <StackPanel>
                <!-- Vạch chỉ báo vị trí chèn khi kéo-thả sắp xếp quy tắc -->
                <Border x:Name="DropIndicator" Height="3" CornerRadius="2" Margin="4,0,4,4"
                        Background="{DynamicResource BfrAccFg}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="CardBorder" Style="{StaticResource InteractiveCardStyle}" Margin="0,0,0,8" Padding="12,10"
                        AllowDrop="True" DragEnter="RuleCard_DragEnter" DragOver="RuleCard_DragOver" DragLeave="RuleCard_DragLeave" Drop="RuleCard_Drop">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tay nắm kéo thả -->
                            <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource TextDisabled}"
                                       VerticalAlignment="Center" Cursor="SizeAll" Background="Transparent"
                                       MouseLeftButtonDown="RuleDragStart_Click" Margin="0,0,10,0"
                                       ToolTip="{DynamicResource RuleDragHint}"
                                       AutomationProperties.Name="{DynamicResource RuleDragHandleA11y}" />

                            <!-- Tên & Tóm tắt tham số quy tắc (bấm để mở rộng/thu gọn) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Cursor="Hand" Background="Transparent" MouseLeftButtonUp="RuleHeader_Click">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Toggle Switch bật/tắt nhanh quy tắc -->
                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                       Margin="6,0,4,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource RuleToggleA11y}" />

                            <!-- Nút mở Regex Tester (nếu quy tắc hỗ trợ) -->
                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE946;"
                                    Click="RuleRegexTester_Click" Tag="{Binding}" Margin="2,0"
                                    ToolTip="{DynamicResource RegexTesterOpen}"
                                    Visibility="{Binding CanOpenRegexTester, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Open regex tester" />

                            <!-- Nút menu thao tác quy tắc (⋯) -->
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                                    Click="RuleMoreMenu_Click" Tag="{Binding}" Margin="2,0,0,0"
                                    ToolTip="{DynamicResource RuleEditHint}"
                                    AutomationProperties.Name="Rule actions" />
                        </Grid>

                        <!-- Bảng tham số chỉnh sửa accordion tại chỗ -->
                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource SurfaceHover}" BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                      Visibility="{Binding Kind, Converter={StaticResource ParameterKindToVis}, ConverterParameter=Toggle}" />
                                            <StackPanel Grid.Column="1"
                                                        Visibility="{Binding Kind, Converter={StaticResource ParameterKindToTextVis}, ConverterParameter=Text}">
                                                <TextBox x:Name="ParamTextBox" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                                                <ContentControl x:Name="TokenPickerHost" Margin="0,6,0,0" Visibility="Collapsed"
                                                                Loaded="TokenPickerHost_Loaded" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Visibility="{Binding Kind, Converter={StaticResource ParameterKindToVis}, ConverterParameter=Multiline}">
                                                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                                         MinHeight="90" MaxHeight="180"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         AutomationProperties.Name="{Binding Label}" />
                                                <ui:Button Appearance="Secondary" Margin="0,6,0,0" Click="ImportListFile_Click"
                                                           Content="{DynamicResource ListImportButton}"
                                                           Visibility="{Binding CanImportFile, Converter={StaticResource BoolToVis}}"
                                                           AutomationProperties.Name="Import list from file" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                      Visibility="{Binding Kind, Converter={StaticResource ParameterKindToChoiceVis}, ConverterParameter=Choice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Cột tên cũ có highlight đoạn bị thay đổi -->
        <DataTemplate x:Key="OldNameTemplate">
            <ItemsControl ItemsSource="{Binding OldSegments}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="SegBorder" CornerRadius="3" Padding="2,0" Background="Transparent">
                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="None" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DiffRemovedText}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="{DynamicResource DiffRemoved}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Cột tên mới có highlight đoạn thêm mới + sửa thủ công tại chỗ (F2 / nhấp đúp) + huy hiệu Manual -->
        <DataTemplate x:Key="NewNameTemplate">
            <Grid Background="Transparent" MouseLeftButtonDown="NewNameCell_MouseDown" ToolTip="{DynamicResource InlineRenameHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="NewNameSegments" Grid.Column="0" ItemsSource="{Binding NewSegments}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SegBorder" CornerRadius="3" Padding="2,0" Background="Transparent">
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DiffAddedText}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                    <Setter TargetName="SegBorder" Property="Background" Value="{DynamicResource DiffAdded}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="InlineRenameBox" Grid.Column="0" Grid.ColumnSpan="2"
                         Visibility="Collapsed" Padding="4,1" FontSize="12.5"
                         VerticalAlignment="Center"
                         KeyDown="InlineRenameBox_KeyDown"
                         LostFocus="InlineRenameBox_LostFocus" />
                <Border x:Name="ManualBadge" Grid.Column="1" CornerRadius="6" Padding="5,1" Margin="6,0,0,0"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasManualOverride, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource ManualBadge}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                </Border>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Khung kiểu macOS: thanh bên | toolbar hợp nhất + (trang | inspector) + thanh trạng thái -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thu thanh bên = thu độ rộng vùng cắt; nội dung giữ nguyên 232 px nên không bị bóp méo. -->
            <Border x:Name="SidebarClip" Width="232" ClipToBounds="True">
                <Border x:Name="SidebarSurface" Width="232" HorizontalAlignment="Right" Background="{DynamicResource Mac.SidebarSolid}"
                        BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,1,0">
                    <mac:MacSourceList x:Name="Sidebar" KeyboardNavigation.TabNavigation="Continue" />
                </Border>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource Mac.ContentBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <mac:MacUnifiedToolbar x:Name="Toolbar" Grid.Row="0" />

                <Border x:Name="StatusBar" Grid.Row="2" Height="26" Visibility="Collapsed" Background="{DynamicResource Mac.ToolbarBg}"
                        BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="StatusBarText" Style="{DynamicResource Mac.Callout}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="InspectorClip" Grid.Column="1" Width="0" IsEnabled="False" ClipToBounds="True">
                        <Border Width="300" HorizontalAlignment="Left" Background="{DynamicResource Mac.PaneBg}"
                                BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1,0,0,0">
                            <ContentControl x:Name="InspectorContent" Focusable="False" />
                        </Border>
                    </Border>

                <!-- Vùng trang: trang Đổi tên là phần nội dung cũ; các trang khác được tạo khi cần -->
                <Grid x:Name="PageHost" Grid.Row="1">
                <Grid x:Name="RenamePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- CommandBar -->
                        <RowDefinition Height="*" />    <!-- Stage Left + 300px Right Inspector -->
                    </Grid.RowDefinitions>

        <!-- ================= 1. Thanh công cụ (CommandBar) ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BfrGlassFillStrong}"
                BorderBrush="{DynamicResource BfrLine}" BorderThickness="0,1,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nhóm nạp tệp nguồn -->
                    <Button Style="{StaticResource BfrPrimaryButton}" Click="AddFiles_Click" Padding="14,6" AutomationProperties.Name="{DynamicResource AddFilesButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource AddFilesButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ui:Button Appearance="Secondary" Click="AddFolder_Click" Margin="6,0,0,0" Padding="12,6" AutomationProperties.Name="{DynamicResource AddFolderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource AddFolderButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Style="{StaticResource VerticalDividerStyle}" />

                    <ui:Button x:Name="ShelfButton" Appearance="Secondary" Click="Shelf_Click" Margin="6,0,0,0" Padding="12,6" AutomationProperties.Name="{DynamicResource ShelfCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShelfButtonText" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Style="{StaticResource VerticalDividerStyle}" />

                    <!-- Nhóm tùy chọn quét -->
                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{DynamicResource RecursiveChip}"
                                  IsChecked="{Binding IsRecursive, Mode=TwoWay}"
                                  AutomationProperties.Name="Include subfolders" />
                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{DynamicResource IncludeFoldersChip}"
                                  IsChecked="{Binding IncludeFolders, Mode=TwoWay}"
                                  AutomationProperties.Name="Include folders" />

                    <Rectangle Style="{StaticResource VerticalDividerStyle}" />

                    <!-- Bộ chọn sắp xếp -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource SortByLabel}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0" />
                        <ComboBox x:Name="SortCombo" Width="170" SelectionChanged="SortCombo_SelectionChanged"
                                  AutomationProperties.Name="Sort order">
                            <ComboBoxItem Content="{DynamicResource SortNameNatural}" Tag="NameNatural" />
                            <ComboBoxItem Content="{DynamicResource SortName}" Tag="NameOrdinal" />
                            <ComboBoxItem Content="{DynamicResource SortCreated}" Tag="Created" />
                            <ComboBoxItem Content="{DynamicResource SortModified}" Tag="Modified" />
                            <ComboBoxItem Content="{DynamicResource SortSize}" Tag="Size" />
                            <ComboBoxItem Content="{DynamicResource SortLoadOrder}" Tag="LoadOrder" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <!-- Nhóm thao tác bên phải -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent" Click="SendToTools_Click"
                            ToolTip="{DynamicResource SendToToolsTip}" Margin="0,0,4,0"
                            AutomationProperties.Name="Send to tools">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            <TextBlock Text="{DynamicResource SendToToolsButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Click="ClearList_Click"
                            ToolTip="{DynamicResource ClearListButton}" Margin="0,0,4,0"
                            AutomationProperties.Name="Clear list">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            <TextBlock Text="{DynamicResource ClearListButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary" Click="MoreMenu_Click" Padding="10,5"
                            AutomationProperties.Name="More actions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            <TextBlock Text="{DynamicResource MoreMenu}" Margin="6,0,0,0" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. Vùng làm việc macOS (Stage Left + 300px Right Inspector) ================= -->
        <Grid Grid.Row="1" Margin="16,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Cột phải: macOS Right Inspector (#252525 + 1px left divider) -->
            <Border Grid.Column="2" Background="{DynamicResource BfrInspectorFill}"
                    BorderBrush="{DynamicResource BfrLine}" BorderThickness="1,1,0,0"
                    CornerRadius="0" Padding="14">
                <DockPanel>
                    <!-- Tiêu đề & Chọn Preset -->
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource RuleBuilderHeader}" Style="{StaticResource PanelHeaderTextStyle}" />
                            <ComboBox x:Name="PresetCombo" Margin="0,6,0,0"
                                      SelectionChanged="PresetCombo_SelectionChanged"
                                      AutomationProperties.Name="Preset selection">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                                Click="PresetMenu_Click" VerticalAlignment="Bottom" Margin="4,0,0,0"
                                ToolTip="{DynamicResource RuleMenuManage}"
                                AutomationProperties.Name="Preset menu" />
                    </Grid>

                    <!-- Sticky Bottom Inspector Footer: Nút thêm quy tắc + Thanh tóm tắt + CTA chính -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Appearance="Secondary" Click="SavePreset_Click" Margin="0,0,6,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip="{DynamicResource SaveAsPresetButton}"
                                    AutomationProperties.Name="Save as preset button">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource SaveAsPresetButton}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:Button>
                            <Button Grid.Column="1" Style="{StaticResource BfrPrimaryButton}" Click="AddRule_Click"
                                    AutomationProperties.Name="Add rule button">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource AddRuleButton}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BfrLine}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Content="{DynamicResource Undo}" Click="Undo_Click"
                                               IsEnabled="{Binding CanUndo}" Padding="10,4" FontSize="12"
                                               AutomationProperties.Name="Undo last rename" />
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource BfrFg2}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- Báo thành công / Huỷ -->
                                <Border Margin="0,0,0,8" Style="{StaticResource BfrToast}" Padding="10,6"
                                        Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}"
                                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Success banner">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource BfrGhostButton}" Content="{DynamicResource Undo}" Click="Undo_Click" Padding="6,2" FontSize="11.5" />
                                            <Button Style="{StaticResource BfrGhostButton}" Content="{DynamicResource MenuHistory}" Click="History_Click" Padding="6,2" FontSize="11.5" />
                                            <Button Style="{StaticResource BfrGhostButton}" Content="{DynamicResource MenuExportReport}" Click="ExportReport_Click" Padding="6,2" FontSize="11.5" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </DockPanel>
                                </Border>

                                <ui:Button Appearance="Transparent" Content="{DynamicResource Cancel}"
                                           Click="CancelWork_Click" Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Right"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                                <Button x:Name="ApplyButton" Style="{StaticResource BfrPrimaryButton}" Click="Apply_Click"
                                        IsEnabled="{Binding CanApply}" HorizontalAlignment="Stretch" Height="40"
                                        AutomationProperties.Name="Apply renaming">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ApplyButtonText}" FontWeight="SemiBold" FontSize="13"
                                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                             Foreground="{DynamicResource TextOnAccent}" />
                                            <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Danh sách rỗng -->
                    <Grid DockPanel.Dock="Top" Margin="2,4">
                        <TextBlock Text="{DynamicResource RulesEmpty}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVis}}" />
                    </Grid>

                    <!-- Cuộn danh sách thẻ quy tắc -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,2,4,2">
                        <ItemsControl x:Name="RulesItems" ItemsSource="{Binding Rules}"
                                      ItemTemplate="{StaticResource RuleCardTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Thanh kéo phân chia độ rộng -->
            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize rule panel" />

            <!-- Cột trái: Stage / Bảng xem trước kết quả đổi tên -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hàng ô thống kê (bento tương tác): bấm trực tiếp để lọc bảng xem trước -->
                <Grid Grid.Row="0" Margin="0,0,0,10" Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KpiWillChangeRing" Grid.Column="0" CornerRadius="{DynamicResource BfrRadiusTileSm}" BorderThickness="2" BorderBrush="Transparent" Margin="0">
                        <ctl:GlassTile x:Name="KpiWillChange" IsInteractive="True" Tag="WillChange" Invoked="KpiTile_Invoked"
                                       CornerRadius="{DynamicResource BfrRadiusTileSm}" Padding="16,10"
                                       AutomationProperties.Name="{DynamicResource FilterWillChange}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding WillChangeCount}" FontFamily="{DynamicResource BfrFontDisplay}" FontSize="26"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BfrAccFg}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource FilterWillChange}" Style="{StaticResource CaptionTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:GlassTile>
                    </Border>
                    <Border x:Name="KpiUnchangedRing" Grid.Column="1" CornerRadius="{DynamicResource BfrRadiusTileSm}" BorderThickness="2" BorderBrush="Transparent" Margin="10,0,0,0">
                        <ctl:GlassTile x:Name="KpiUnchanged" IsInteractive="True" Tag="Unchanged" Invoked="KpiTile_Invoked"
                                       CornerRadius="{DynamicResource BfrRadiusTileSm}" Padding="16,10"
                                       AutomationProperties.Name="{DynamicResource FilterUnchanged}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UnchangedCount}" FontFamily="{DynamicResource BfrFontDisplay}" FontSize="26"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BfrFg2}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource FilterUnchanged}" Style="{StaticResource CaptionTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:GlassTile>
                    </Border>
                    <Border x:Name="KpiProblemsRing" Grid.Column="2" CornerRadius="{DynamicResource BfrRadiusTileSm}" BorderThickness="2" BorderBrush="Transparent" Margin="10,0,0,0">
                        <ctl:GlassTile x:Name="KpiProblems" IsInteractive="True" Tag="Problems" Invoked="KpiTile_Invoked"
                                       CornerRadius="{DynamicResource BfrRadiusTileSm}" Padding="16,10"
                                       AutomationProperties.Name="{DynamicResource FilterProblems}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ErrorCount}" FontFamily="{DynamicResource BfrFontDisplay}" FontSize="26"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BfrBad}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource FilterProblems}" Style="{StaticResource CaptionTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:GlassTile>
                    </Border>
                </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BfrGlassFill}"
                    BorderBrush="{DynamicResource BfrGlassRim}" BorderThickness="1"
                    CornerRadius="{DynamicResource BfrRadiusTile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thanh bộ lọc dạng Segmented Tab + Ô tìm kiếm (đặt trên bảng xem trước) -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Segmented Filter Container -->
                            <Border Grid.Column="0" Background="{DynamicResource ChipBackground}"
                                    CornerRadius="8" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterAll}"
                                                 IsChecked="True" Checked="Filter_Checked" Tag="All"
                                                 AutomationProperties.Name="Filter all" />
                                    <RadioButton x:Name="FilterWillChange" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterWillChange}"
                                                 Checked="Filter_Checked" Tag="WillChange"
                                                 AutomationProperties.Name="Filter will change" />
                                    <RadioButton x:Name="FilterUnchanged" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterUnchanged}"
                                                 Checked="Filter_Checked" Tag="Unchanged"
                                                 AutomationProperties.Name="Filter unchanged" />
                                    <RadioButton x:Name="FilterProblems" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterProblems}"
                                                 Checked="Filter_Checked" Tag="Problems"
                                                 AutomationProperties.Name="Filter problems" />
                                </StackPanel>
                            </Border>

                            <!-- Ô tìm kiếm tệp -->
                            <ui:TextBox Grid.Column="1" Width="230" VerticalAlignment="Center" x:Name="PreviewSearchBox"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                                        AutomationProperties.Name="Search files" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Cảnh báo trùng tên: một nút tự thêm (2), (3)… -->
                            <Border Margin="10,10,10,0" Padding="12,8" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                                    Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Conflict banner">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Margin="12,0,0,0"
                                               Content="{DynamicResource ConflictAutoFix}"
                                               Command="{Binding ResolveConflictsCommand}"
                                               AutomationProperties.Name="Fix conflicts automatically" />
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ConflictBannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </DockPanel>
                            </Border>
                            <!-- Sau khi bật tự xử lý: cho biết đã làm gì và cho tắt -->
                            <Border Margin="10,10,10,0" Padding="12,8" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                    Visibility="{Binding HasAutoResolved, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Auto resolved banner">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Margin="12,0,0,0"
                                               Content="{DynamicResource ConflictAutoOff}"
                                               Command="{Binding StopAutoResolveCommand}"
                                               AutomationProperties.Name="Turn off auto resolve" />
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding AutoResolvedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    <DataGrid x:Name="PreviewGrid" Style="{StaticResource PreviewDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource PreviewHeaderStyle}"
                              CellStyle="{StaticResource PreviewCellStyle}"
                              ItemsSource="{Binding FilteredRows}"
                              SelectionChanged="PreviewGrid_SelectionChanged"
                              PreviewKeyDown="PreviewGrid_PreviewKeyDown"
                              AutomationProperties.Name="Preview table">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource PreviewRowStyle}">
                                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Cột Checkbox chọn từng dòng -->
                            <DataGridTemplateColumn Width="48" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.AreAllRowsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Style="{StaticResource AppCheckBoxStyle}"
                                                  ToolTip="{DynamicResource ColSelectTooltip}"
                                                  AutomationProperties.Name="Select or deselect all files" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Focusable="False"
                                                  Style="{StaticResource AppCheckBoxStyle}"
                                                  AutomationProperties.Name="Include file in rename" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Tên cũ -->
                            <DataGridTemplateColumn Header="{DynamicResource ColOld}" Width="*" MinWidth="130"
                                                    SortMemberPath="OldName" CanUserSort="True"
                                                    CellTemplate="{StaticResource OldNameTemplate}" />

                            <!-- Cột Tên mới -->
                            <DataGridTemplateColumn Header="{DynamicResource ColNew}" Width="*" MinWidth="130"
                                                    SortMemberPath="NewName" CanUserSort="True"
                                                    CellTemplate="{StaticResource NewNameTemplate}" />

                            <!-- Cột Trạng thái dạng Pill Badge hiện đại -->
                            <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="124"
                                                    SortMemberPath="StatusText" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusPill" CornerRadius="10" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ChipBackground}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="StatusIcon" Text="{Binding StatusIcon}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}"
                                                           FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Success}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Warning}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="InvalidName">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource ErrorSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PathTooLong">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource ErrorSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource ErrorSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Protected">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource ErrorSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MissingData">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Warning}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thư mục -->
                            <DataGridTemplateColumn Header="{DynamicResource ColFolder}" Width="0.7*" MinWidth="70" SortMemberPath="FolderText" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderText}" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding FolderText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>

                    <!-- Ngăn Rule Trace (tự thu gọn khi chưa chọn dòng) -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="12,8"
                            Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TraceHeader}" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding TraceSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE16A;" FontSize="11"
                                                       FontFamily="{StaticResource IconFont}"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                       FontSize="11.5" Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Màn hình trạng thái rỗng (Empty State Hero) -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource AppBackground}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Padding="40,32"
                        CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Divider}"
                        Background="{DynamicResource SurfaceBackground}">
                <StackPanel>
                    <ctl:TemMascot x:Name="EmptyMascot" Width="76" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource EmptyTitle}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource EmptyHint}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource BfrPrimaryButton}" Click="AddFiles_Click" Content="{DynamicResource AddFilesButton}" Padding="16,8" />
                        <ui:Button Appearance="Secondary" Click="AddFolder_Click" Margin="10,0,0,0"
                                Content="{DynamicResource AddFolderButton}" Padding="14,8" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource EmptySuggestions}" Style="{StaticResource PanelHeaderTextStyle}"
                               HorizontalAlignment="Center" Margin="0,28,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Appearance="Secondary" Click="SuggestPreset_Click" Tag="Đánh số theo thứ tự"
                                Content="{DynamicResource SuggestNumbering}" Padding="10,6" />
                        <ui:Button Appearance="Secondary" Click="SuggestPreset_Click" Tag="Dọn dẹp tên tệp"
                                Content="{DynamicResource SuggestTrim}" Margin="8,0,0,0" Padding="10,6" />
                        <ui:Button Appearance="Secondary" Click="SuggestPreset_Click" Tag="Ảnh theo ngày chụp"
                                Content="{DynamicResource SuggestDate}" Margin="8,0,0,0" Padding="10,6" />
                    </StackPanel>

                    <!-- Mẹo: ba cách khác để đưa tệp vào mà không cần mở cửa sổ này -->
                    <TextBlock Text="{DynamicResource EmptyTips}" Style="{StaticResource CaptionTextStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0"
                               AutomationProperties.Name="Empty state tips" />
                </StackPanel>
                </Border>
            </Border>
            </Grid>
        </Grid>
                </Grid>
                </Grid>
            </Grid>
        </Grid>

            <!-- Traffic light nằm đè góc trái trên nên không đổi chỗ khi thu thanh bên -->
            <!-- Trải cả hai cột: nếu chỉ nằm ở cột đầu thì cột thanh bên không co được dưới độ rộng cụm nút. -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" Background="Transparent">
                <Button x:Name="CloseDot" Style="{DynamicResource Mac.TrafficDot}" Background="#FF5F57" Tag="×" Click="CloseDot_Click" />
                <Button x:Name="MinimizeDot" Style="{DynamicResource Mac.TrafficDot}" Background="#FEBC2E" Tag="–" Click="MinimizeDot_Click" />
                <Button x:Name="ZoomDot" Style="{DynamicResource Mac.TrafficDot}" Background="#28C840" Tag="+" Click="ZoomDot_Click" />
            </StackPanel>

            <!-- Vùng hiển thị hộp thoại nổi (ContentDialog) phủ lên toàn cửa sổ -->
            <ui:ContentDialogHost x:Name="DialogHost" Grid.ColumnSpan="2" />
        </Grid>

        <!-- Lớp phủ kính mờ khi kéo tệp vào bất kỳ vị trí nào trên cửa sổ -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Panel.ZIndex="100"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="#99000000">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="48,36"
                    CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource BfrAccFg}"
                    Background="{DynamicResource BfrGlassFillStrong}">
                <StackPanel HorizontalAlignment="Center">
                    <ctl:TemMascot x:Name="DropOverlayMascot" State="Happy" Width="76" Height="80"
                                   HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource WindowDropOverlayTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource BfrFg}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource WindowDropOverlayHint}" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
