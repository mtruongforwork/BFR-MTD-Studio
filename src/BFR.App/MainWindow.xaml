<ui:FluentWindow x:Class="BFR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BFR.App"
        xmlns:conv="clr-namespace:BFR.App.Converters"
        xmlns:ctl="clr-namespace:BFR.App.Controls"
        xmlns:mac="clr-namespace:BFR.App.Controls.Mac"
        xmlns:mac2="clr-namespace:BFR.App.Infrastructure"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource WindowTitle}" Height="820" Width="1380"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Tabbed"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" PreviewDrop="Window_PreviewDrop" Drop="Window_Drop"
        AutomationProperties.Name="FileFlow Studio Main Window">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Giao diện kiểu macOS. Bảng màu được MacTheme.Apply thay theo sáng/tối, màu nhấn và tương phản cao. -->
                <ResourceDictionary Source="Themes/Mac/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Mac/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Mac/Icons.xaml" />
                <ResourceDictionary Source="Themes/Mac/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Menu ngữ cảnh cho từng dòng trong bảng xem trước (v1.0.2) -->
        <ContextMenu x:Key="RowContextMenu" Style="{StaticResource Mac.ContextMenu}">
            <MenuItem Header="{DynamicResource CtxOpenFile}" Click="ContextMenu_OpenFile_Click" />
            <MenuItem Header="{DynamicResource CtxOpenFolder}" Click="ContextMenu_OpenFolder_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource CtxCopyOldName}" Click="ContextMenu_CopyOldName_Click" />
            <MenuItem Header="{DynamicResource CtxCopyNewName}" Click="ContextMenu_CopyNewName_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource CtxManualRename}" InputGestureText="F2" Click="ContextMenu_ManualRename_Click" />
            <MenuItem Header="{DynamicResource CtxResetManualName}" Click="ContextMenu_ResetManualName_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource CtxToggleSelect}" Click="ContextMenu_ToggleSelect_Click" />
            <MenuItem Header="{DynamicResource CtxRemoveFromList}" Click="ContextMenu_RemoveFromList_Click" />
        </ContextMenu>

        <!-- Thẻ quy tắc: một nhóm kiểu inset grouped trong inspector 300 px; tham số mở tại chỗ, nhãn nằm trên ô nhập. -->
        <DataTemplate x:Key="RuleCardTemplate">
            <Border x:Name="CardBorder" Style="{StaticResource Mac.Group}" Padding="8,8,6,8" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Tay nắm kéo thả -->
                        <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" Padding="0,6,8,6" VerticalAlignment="Center"
                                MouseLeftButtonDown="RuleDragStart_Click"
                                ToolTip="{DynamicResource RuleDragHint}" AutomationProperties.Name="{DynamicResource RuleDragHandleA11y}">
                            <mac:MacIcon Data="{StaticResource Icon.GripVertical}" Size="14" Foreground="{DynamicResource Mac.Label3}" />
                        </Border>

                        <!-- Tên và tóm tắt (bấm để mở/gập tham số) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                    Cursor="Hand" Background="Transparent" MouseLeftButtonUp="RuleHeader_Click">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Mac.Headline}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Mac.Callout}" FontSize="11" />
                        </StackPanel>

                        <ToggleButton Grid.Column="2" Style="{StaticResource Mac.Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource RuleToggleA11y}" />

                        <Button Grid.Column="3" Style="{StaticResource Mac.ToolbarButton}" MinWidth="24" Height="24" Padding="3,0" Margin="4,0,0,0"
                                Click="RuleRegexTester_Click" Tag="{Binding}" ToolTip="{DynamicResource RegexTesterOpen}"
                                Visibility="{Binding CanOpenRegexTester, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Open regex tester">
                            <mac:MacIcon Data="{StaticResource Icon.Info}" Size="14" />
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource Mac.ToolbarButton}" MinWidth="24" Height="24" Padding="3,0"
                                Click="RuleMoreMenu_Click" Tag="{Binding}" ToolTip="{DynamicResource RuleEditHint}"
                                AutomationProperties.Name="Rule actions">
                            <mac:MacIcon Data="{StaticResource Icon.Ellipsis}" Size="15" />
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,6,2,0">
                        <Border Style="{StaticResource Mac.RowLine}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Mac.Callout}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        <ToggleButton Style="{StaticResource Mac.Switch}" HorizontalAlignment="Left" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Label}"
                                                      Visibility="{Binding Kind, Converter={StaticResource ParameterKindToVis}, ConverterParameter=Toggle}" />
                                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource ParameterKindToTextVis}, ConverterParameter=Text}">
                                            <TextBox x:Name="ParamTextBox" Style="{StaticResource Mac.TextBox}" AutomationProperties.Name="{Binding Label}"
                                                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                                            <ContentControl x:Name="TokenPickerHost" Margin="0,6,0,0" Visibility="Collapsed" Loaded="TokenPickerHost_Loaded" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource ParameterKindToVis}, ConverterParameter=Multiline}">
                                            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                                     MinHeight="90" MaxHeight="180"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="{Binding Label}" />
                                            <Button Style="{StaticResource Mac.Button.Small}" Margin="0,6,0,0" HorizontalAlignment="Left" Click="ImportListFile_Click"
                                                    Content="{DynamicResource ListImportButton}"
                                                    Visibility="{Binding CanImportFile, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Import list from file" />
                                        </StackPanel>
                                        <ComboBox Style="{StaticResource Mac.ComboBox}" ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"
                                                  Visibility="{Binding Kind, Converter={StaticResource ParameterKindToChoiceVis}, ConverterParameter=Choice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Một đoạn chữ của tên cũ/mới. Dòng đang chọn: chữ theo màu chọn để luôn đọc được trên nền nhấn. -->
        <Style x:Key="DiffText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DiffRemovedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DiffText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiffSegment" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Cột tên cũ: đoạn bị thay đổi có nền đỏ và gạch ngang -->
        <DataTemplate x:Key="OldNameTemplate">
            <ItemsControl ItemsSource="{Binding OldSegments}" VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="SegBorder" Style="{StaticResource DiffSegment}">
                            <TextBlock Text="{Binding DisplayText}" Style="{StaticResource DiffRemovedTextStyle}" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="{DynamicResource Mac.DiffDelBg}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Cột tên mới: đoạn thêm mới có nền xanh (tương phản cao: gạch chân), sửa tại chỗ bằng F2 hoặc nhấp đúp -->
        <DataTemplate x:Key="NewNameTemplate">
            <Grid Background="Transparent" MouseLeftButtonDown="NewNameCell_MouseDown" ToolTip="{DynamicResource InlineRenameHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="NewNameSegments" Grid.Column="0" ItemsSource="{Binding NewSegments}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SegBorder" Style="{StaticResource DiffSegment}">
                                <TextBlock x:Name="SegText" Text="{Binding DisplayText}" Style="{StaticResource DiffText}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                    <Setter TargetName="SegBorder" Property="Background" Value="{DynamicResource Mac.DiffAddBg}" />
                                    <Setter TargetName="SegBorder" Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter TargetName="SegBorder" Property="BorderBrush" Value="{DynamicResource Mac.DiffAddLine}" />
                                    <Setter TargetName="SegText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="InlineRenameBox" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Mac.TextBox}" Height="22"
                         Visibility="Collapsed" FontSize="12.5" VerticalAlignment="Center"
                         KeyDown="InlineRenameBox_KeyDown" LostFocus="InlineRenameBox_LostFocus" />
                <Border x:Name="ManualBadge" Grid.Column="1" CornerRadius="5" Padding="5,0" Margin="6,0,0,0"
                        Background="{DynamicResource Mac.AccentSoft}" VerticalAlignment="Center"
                        Visibility="{Binding HasManualOverride, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource ManualBadge}" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Nút lọc kiểu thanh phạm vi (scope bar) của Finder -->
        <Style x:Key="ScopeButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource Mac.FontMedium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Mac.Label2}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Wash" CornerRadius="6" Background="{DynamicResource Mac.Hover}" Opacity="0" />
                            <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource Mac.Track}" Visibility="Collapsed" />
                            <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Mac.FocusRing}" Visibility="Collapsed" />
                            <ContentPresenter Margin="9,3" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Phần của trang Đổi tên nằm trên khung (toolbar, inspector). Khai báo ở đây để giữ x:Name và trình xử lý;
             InitializeRenameShell tháo ra và giao cho khung khi mở trang Đổi tên. -->
        <Grid x:Name="RenameParts" Visibility="Collapsed">
            <StackPanel x:Name="RenameToolbarCenter" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddMenuButton" Style="{StaticResource Mac.ToolbarButton}" Click="AddMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <mac:MacIcon Data="{StaticResource Icon.Plus}" Size="17" />
                        <mac:MacIcon Data="{StaticResource Icon.ChevronDown}" Size="10" Margin="2,0,0,0" />
                    </StackPanel>
                </Button>
                <ComboBox x:Name="SortCombo" Style="{StaticResource Mac.ComboBox}" Width="138" MinWidth="100" Margin="8,0,6,0"
                          SelectionChanged="SortCombo_SelectionChanged" ToolTip="{DynamicResource SortByLabel}" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="{DynamicResource SortNameNatural}" Tag="NameNatural" />
                    <ComboBoxItem Content="{DynamicResource SortName}" Tag="NameOrdinal" />
                    <ComboBoxItem Content="{DynamicResource SortCreated}" Tag="Created" />
                    <ComboBoxItem Content="{DynamicResource SortModified}" Tag="Modified" />
                    <ComboBoxItem Content="{DynamicResource SortSize}" Tag="Size" />
                    <ComboBoxItem Content="{DynamicResource SortLoadOrder}" Tag="LoadOrder" />
                </ComboBox>
                <Button Style="{StaticResource Mac.ToolbarButton}" Click="ClearList_Click" ToolTip="{DynamicResource ClearListButton}"
                        AutomationProperties.Name="Clear list">
                    <mac:MacIcon Data="{StaticResource Icon.Trash2}" Size="15" />
                </Button>
                <Button Style="{StaticResource Mac.ToolbarButton}" Click="MoreMenu_Click" ToolTip="{DynamicResource MoreMenu}"
                        AutomationProperties.Name="More actions">
                    <mac:MacIcon Data="{StaticResource Icon.Ellipsis}" Size="17" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="RenameToolbarTrailing" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PreviewSearchBox" Style="{StaticResource Mac.SearchBox}" Width="128" Margin="0,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search files" />
                <Button x:Name="ApplyButton" Style="{StaticResource Mac.Button.Primary}" Click="Apply_Click" IsEnabled="{Binding CanApply}"
                        AutomationProperties.Name="Apply renaming">
                    <Grid>
                        <TextBlock Text="{Binding ApplyButtonText}" Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{Binding BusyText}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
            </StackPanel>

            <DockPanel x:Name="RenameInspector">
                <mac:MacSegmentedControl x:Name="InspectorTabs" DockPanel.Dock="Top" Margin="12,10,12,4" />

                <Border x:Name="RulesFooter" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,1,0,0" Padding="12,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Mac.Button.Primary}" Click="AddRule_Click"
                                AutomationProperties.Name="Add rule button">
                            <StackPanel Orientation="Horizontal">
                                <mac:MacIcon Data="{StaticResource Icon.Plus}" Size="13" Foreground="{DynamicResource Mac.OnAccent}" Margin="0,0,5,0" />
                                <TextBlock Text="{DynamicResource AddRuleButton}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Mac.Button}" HorizontalAlignment="Left" Click="SavePreset_Click" MaxWidth="140" Margin="0,0,8,0"
                                ToolTip="{DynamicResource SaveAsPresetButton}" AutomationProperties.Name="Save as preset button">
                            <TextBlock Text="{DynamicResource SaveAsPresetButton}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DockPanel>
                </Border>

                <Grid>
                    <DockPanel x:Name="RulesPanel">
                        <DockPanel DockPanel.Dock="Top" Margin="12,8,10,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Mac.ToolbarButton}" MinWidth="26" Height="24" Padding="3,0" Margin="6,0,0,0"
                                    Click="PresetMenu_Click" ToolTip="{DynamicResource RuleMenuManage}" AutomationProperties.Name="Preset menu">
                                <mac:MacIcon Data="{StaticResource Icon.Ellipsis}" Size="15" />
                            </Button>
                            <ComboBox x:Name="PresetCombo" Style="{StaticResource Mac.ComboBox}" SelectionChanged="PresetCombo_SelectionChanged"
                                      AutomationProperties.Name="Preset selection">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource RuleBuilderHeader}" Style="{StaticResource Mac.Section}" Margin="16,2,12,6" />
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource RulesEmpty}" Style="{StaticResource Mac.Callout}" TextWrapping="Wrap" Margin="16,0,16,8"
                                   Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVis}}" />
                        <ScrollViewer Style="{StaticResource Mac.ScrollViewer}">
                            <ItemsControl x:Name="RulesItems" ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource RuleCardTemplate}"
                                          Margin="12,0,12,4" Background="Transparent" Focusable="False"
                                          AllowDrop="True" DragOver="RuleList_DragOver" DragLeave="RuleList_DragLeave" Drop="RuleList_Drop" />
                        </ScrollViewer>
                    </DockPanel>

                    <ScrollViewer x:Name="TracePanel" Style="{StaticResource Mac.ScrollViewer}" Visibility="Collapsed">
                        <StackPanel Margin="12,8">
                            <TextBlock x:Name="TraceEmptyText" Style="{StaticResource Mac.Callout}" TextWrapping="Wrap" Margin="4,0" />
                            <StackPanel x:Name="TraceContent" Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVis}}">
                                <TextBlock Text="{DynamicResource TraceHeader}" Style="{StaticResource Mac.Section}" TextWrapping="Wrap" Margin="4,0,0,6" />
                                <Border Style="{StaticResource Mac.Group}">
                                    <ItemsControl ItemsSource="{Binding TraceSteps}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Mac.Headline}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Mac.Callout}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Khung kiểu macOS: thanh bên | toolbar hợp nhất + (trang | inspector) + thanh trạng thái -->
        <Grid x:Name="ShellRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thu thanh bên = thu độ rộng vùng cắt; nội dung giữ nguyên 232 px nên không bị bóp méo. -->
            <Border x:Name="SidebarClip" Width="232" ClipToBounds="True">
                <Border x:Name="SidebarSurface" Width="232" HorizontalAlignment="Right" Background="{DynamicResource Mac.SidebarSolid}"
                        BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,1,0">
                    <mac:MacSourceList x:Name="Sidebar" KeyboardNavigation.TabNavigation="Continue" />
                </Border>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource Mac.ContentBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <mac:MacUnifiedToolbar x:Name="Toolbar" Grid.Row="0" />

                <Border x:Name="StatusBar" Grid.Row="2" Height="26" Visibility="Collapsed" Background="{DynamicResource Mac.ToolbarBg}"
                        BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="StatusBarText" Style="{DynamicResource Mac.Callout}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="InspectorClip" Grid.Column="1" Width="0" IsEnabled="False" ClipToBounds="True">
                        <Border Width="300" HorizontalAlignment="Left" Background="{DynamicResource Mac.PaneBg}"
                                BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1,0,0,0">
                            <ContentControl x:Name="InspectorContent" Focusable="False" />
                        </Border>
                    </Border>

                <!-- Vùng trang: trang Đổi tên khai báo sẵn ở đây; các trang khác được tạo khi cần -->
                <Grid x:Name="PageHost" Grid.Row="1">
                <Grid x:Name="RenamePage" Background="{DynamicResource Mac.ContentBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Thanh phạm vi -->
                        <RowDefinition Height="Auto" /> <!-- Cảnh báo -->
                        <RowDefinition Height="*" />    <!-- Bảng xem trước -->
                        <RowDefinition Height="Auto" /> <!-- Thanh trạng thái -->
                    </Grid.RowDefinitions>

                    <!-- Thanh phạm vi: lọc bảng xem trước, mỗi mục kèm số lượng chạy theo thay đổi -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,0,1" Padding="12,7">
                        <WrapPanel>
                            <RadioButton x:Name="FilterAll" Style="{StaticResource ScopeButton}" GroupName="PreviewFilter" IsChecked="True"
                                         Checked="Filter_Checked" Tag="All" AutomationProperties.Name="Filter all">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource FilterAll}" />
                                    <TextBlock x:Name="CountAll" Margin="6,0,0,0" Opacity="0.75" mac2:Motion.CountValue="{Binding TotalCount}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FilterWillChange" Style="{StaticResource ScopeButton}" GroupName="PreviewFilter"
                                         Checked="Filter_Checked" Tag="WillChange" AutomationProperties.Name="Filter will change">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource FilterWillChange}" />
                                    <TextBlock x:Name="CountWillChange" Margin="6,0,0,0" Foreground="{DynamicResource Mac.AccentText}" mac2:Motion.CountValue="{Binding WillChangeCount}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FilterUnchanged" Style="{StaticResource ScopeButton}" GroupName="PreviewFilter"
                                         Checked="Filter_Checked" Tag="Unchanged" AutomationProperties.Name="Filter unchanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource FilterUnchanged}" />
                                    <TextBlock x:Name="CountUnchanged" Margin="6,0,0,0" Opacity="0.75" mac2:Motion.CountValue="{Binding UnchangedCount}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FilterProblems" Style="{StaticResource ScopeButton}" GroupName="PreviewFilter"
                                         Checked="Filter_Checked" Tag="Problems" AutomationProperties.Name="Filter problems">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource FilterProblems}" />
                                    <TextBlock x:Name="CountProblems" Margin="6,0,0,0" Foreground="{DynamicResource Mac.Bad}" mac2:Motion.CountValue="{Binding ErrorCount}" />
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <!-- Cảnh báo trùng tên: một nút tự thêm (2), (3)… -->
                        <Border Margin="12,8,12,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource Mac.WarnSoft}"
                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Conflict banner">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Mac.Button.Small}" Margin="12,0,0,0"
                                        Content="{DynamicResource ConflictAutoFix}" Command="{Binding ResolveConflictsCommand}"
                                        AutomationProperties.Name="Fix conflicts automatically" />
                                <mac:MacIcon Data="{StaticResource Icon.TriangleAlert}" Size="16" Foreground="{DynamicResource Mac.Warn}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding ConflictBannerText}" Style="{StaticResource Mac.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <!-- Sau khi bật tự xử lý: cho biết đã làm gì và cho tắt -->
                        <Border Margin="12,8,12,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource Mac.AccentSoft}"
                                Visibility="{Binding HasAutoResolved, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Auto resolved banner">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Mac.Button.Small}" Margin="12,0,0,0"
                                        Content="{DynamicResource ConflictAutoOff}" Command="{Binding StopAutoResolveCommand}"
                                        AutomationProperties.Name="Turn off auto resolve" />
                                <mac:MacIcon Data="{StaticResource Icon.Info}" Size="16" Foreground="{DynamicResource Mac.Accent}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding AutoResolvedText}" Style="{StaticResource Mac.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid x:Name="PreviewGrid" Grid.Row="2" Style="{StaticResource Mac.DataGrid}" Padding="0,2,0,0"
                              ItemsSource="{Binding FilteredRows}" IsReadOnly="True" CanUserSortColumns="True"
                              SelectionChanged="PreviewGrid_SelectionChanged" PreviewKeyDown="PreviewGrid_PreviewKeyDown"
                              AutomationProperties.Name="Preview table">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource Mac.Row}">
                                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.AreAllRowsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                  Style="{StaticResource Mac.CheckBox}" ToolTip="{DynamicResource ColSelectTooltip}"
                                                  AutomationProperties.Name="Select or deselect all files" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Focusable="False"
                                                  Style="{StaticResource Mac.CheckBox}" AutomationProperties.Name="Include file in rename" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource ColOld}" Width="*" MinWidth="120"
                                                    SortMemberPath="OldName" CellTemplate="{StaticResource OldNameTemplate}" />

                            <DataGridTemplateColumn Header="{DynamicResource ColNew}" Width="*" MinWidth="120"
                                                    SortMemberPath="NewName" CellTemplate="{StaticResource NewNameTemplate}" />

                            <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="112" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                            <TextBlock x:Name="StatusIcon" Text="{Binding StatusIcon}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <!-- Màu theo trạng thái chỉ đặt lên icon: chữ luôn theo màu dòng nên đọc được cả khi đang chọn.
                                                 Trạng thái còn được phân biệt bằng icon và chữ, không chỉ bằng màu. -->
                                            <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Ok}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MissingData">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="InvalidName">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PathTooLong">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Protected">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Mac.SelectedFg}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource ColFolder}" Width="0.7*" MinWidth="60" SortMemberPath="FolderText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderText}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.75"
                                                   VerticalAlignment="Center" ToolTip="{Binding FolderText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thanh trạng thái của trang: Huỷ và Hoàn tác luôn dùng được kể cả khi đã ẩn inspector -->
                    <Border Grid.Row="3" Background="{DynamicResource Mac.ToolbarBg}" BorderBrush="{DynamicResource Mac.Separator}"
                            BorderThickness="0,1,0,0" Padding="12,3" MinHeight="30">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Mac.Button.Small}" Click="Undo_Click" IsEnabled="{Binding CanUndo}"
                                    AutomationProperties.Name="Undo last rename">
                                <StackPanel Orientation="Horizontal">
                                    <mac:MacIcon Data="{StaticResource Icon.Undo2}" Size="12" Margin="0,0,5,0" />
                                    <TextBlock Text="{DynamicResource MacUndo}" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Mac.Button.Small}" Margin="0,0,8,0" Content="{DynamicResource Cancel}"
                                    Click="CancelWork_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <mac:MacSpinner DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Mac.Label2}"
                                            AutomationProperties.Name="{Binding BusyText}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Left" x:Name="SummaryText" Text="{Binding StatusSummary}" Style="{StaticResource Mac.Callout}" FontSize="11"
                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Mac.Callout}" FontSize="11" Margin="14,0,8,0" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>

                    <!-- Thông báo kiểu Notification Center ở góc trên phải (M12) -->
                    <Border x:Name="SuccessBanner" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="20" Visibility="Collapsed"
                            Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="12"
                            CornerRadius="12" Background="{DynamicResource Mac.SheetBg}" BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="1"
                            AutomationProperties.Name="Success banner">
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.28" /></Border.Effect>
                        <DockPanel>
                            <mac:MacCheckDraw x:Name="SuccessCheck" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" x:Name="DismissBannerButton" Style="{StaticResource Mac.ToolbarButton}" MinWidth="22" Height="22" Padding="2,0"
                                    VerticalAlignment="Top" Click="DismissBanner_Click">
                                <mac:MacIcon Data="{StaticResource Icon.X}" Size="12" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource Mac.Text}" TextWrapping="Wrap" TextTrimming="None"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Mac.Button.Small}" Margin="0,0,6,0" Content="{DynamicResource MacUndo}" Click="Undo_Click" IsEnabled="{Binding CanUndo}" />
                                    <Button Style="{StaticResource Mac.Button.Small}" Margin="0,0,6,0" Content="{DynamicResource MenuHistory}" Click="History_Click" />
                                    <Button Style="{StaticResource Mac.Button.Small}" Content="{DynamicResource MenuExportReport}" Click="ExportReport_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Trạng thái rỗng: phủ thanh lọc và bảng, chừa thanh trạng thái -->
                    <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10" Style="{StaticResource Mac.ScrollViewer}"
                                  Background="{DynamicResource Mac.ContentBg}"
                                  Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="24" MaxWidth="620" VerticalAlignment="Center">
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Mac.Label4}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                            <StackPanel Margin="24,22">
                                <ctl:TemMascot x:Name="EmptyMascot" Width="68" Height="72" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="{DynamicResource EmptyTitle}" Style="{StaticResource Mac.Title2}" FontSize="18" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource EmptyHint}" Style="{StaticResource Mac.Callout}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Style="{StaticResource Mac.Button.Primary}" Click="AddFiles_Click" Content="{DynamicResource AddFilesButton}" Margin="5,3" />
                                    <Button Style="{StaticResource Mac.Button}" Click="AddFolder_Click" Content="{DynamicResource AddFolderButton}" Margin="5,3" />
                                </WrapPanel>

                                <TextBlock Text="{DynamicResource EmptySuggestions}" Style="{StaticResource Mac.Section}" HorizontalAlignment="Center" Margin="0,20,0,6" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Style="{StaticResource Mac.Button.Small}" Margin="4,3" Click="SuggestPreset_Click" Tag="Đánh số theo thứ tự" Content="{DynamicResource SuggestNumbering}" />
                                    <Button Style="{StaticResource Mac.Button.Small}" Margin="4,3" Click="SuggestPreset_Click" Tag="Dọn dẹp tên tệp" Content="{DynamicResource SuggestTrim}" />
                                    <Button Style="{StaticResource Mac.Button.Small}" Margin="4,3" Click="SuggestPreset_Click" Tag="Ảnh theo ngày chụp" Content="{DynamicResource SuggestDate}" />
                                </WrapPanel>

                                <TextBlock Text="{DynamicResource EmptyTips}" Style="{StaticResource Mac.Callout}" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,18,0,0" AutomationProperties.Name="Empty state tips" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                </Grid>
                </Grid>
            </Grid>
        </Grid>

            <!-- Traffic light nằm đè góc trái trên nên không đổi chỗ khi thu thanh bên -->
            <!-- Nằm ngoài ShellRoot: không được nằm trong cột thanh bên, nếu không cột đó không co về 0 được. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" Background="Transparent">
                <Button x:Name="CloseDot" Style="{DynamicResource Mac.TrafficDot}" Background="#FF5F57" Tag="×" Click="CloseDot_Click" />
                <Button x:Name="MinimizeDot" Style="{DynamicResource Mac.TrafficDot}" Background="#FEBC2E" Tag="–" Click="MinimizeDot_Click" />
                <Button x:Name="ZoomDot" Style="{DynamicResource Mac.TrafficDot}" Background="#28C840" Tag="+" Click="ZoomDot_Click" />
            </StackPanel>

            <!-- Lớp phủ tạm của hiệu ứng phóng to M2 (MacZoom) -->
            <Canvas x:Name="ZoomLayer" IsHitTestVisible="False" />

            <!-- Sheet kiểu macOS (xác nhận áp dụng): phủ cả cửa sổ, khoá ShellRoot khi mở -->
            <mac:MacSheetHost x:Name="SheetHost" />

        <!-- Lớp phủ kính mờ khi kéo tệp vào bất kỳ vị trí nào trên cửa sổ -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Panel.ZIndex="100"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="#99000000">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="48,36"
                    CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource BfrAccFg}"
                    Background="{DynamicResource BfrGlassFillStrong}">
                <StackPanel HorizontalAlignment="Center">
                    <ctl:TemMascot x:Name="DropOverlayMascot" State="Happy" Width="76" Height="80"
                                   HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource WindowDropOverlayTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource BfrFg}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource WindowDropOverlayHint}" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
